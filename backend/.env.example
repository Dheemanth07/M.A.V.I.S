# ==============================================================================
# M.A.V.I.S. Gateway Environment Variables (Template)
# Copy this file to .env before starting the backend
# ==============================================================================

# Server Port
PORT=5000

# Database Connection (Leave empty to use automatic in-memory MongoDB fallback)
MONGO_URI=mongodb://127.0.0.1:27017/mavis

# JWT Secret for Session Authentication (Change in production)
JWT_SECRET=mavis_jwt_dev_secret_change_in_production

# Optional Local Small Language Model (SLM) Endpoint (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
