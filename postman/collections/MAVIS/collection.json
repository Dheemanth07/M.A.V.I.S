                  "  if (json.data && json.data.user) {",
                  "    pm.environment.set('userId', json.data.user.id || json.data.user._id);",
                  "  }",
                  "  if (json.data && json.data.token) {",
                  "    pm.environment.set('token', json.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
