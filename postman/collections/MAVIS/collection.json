    {
      "name": "03 Animals",
      "description": "Animal registry, profile lifecycle, biometric updates, and real-time health summary endpoints.",
      "item": [
        {
          "name": "POST /api/animals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const item = body.data || body;",
                  "  if (item && item._id) pm.environment.set('animalId', item._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bella\",\n  \"species\": \"Canine\",\n  \"breed\": \"Golden Retriever\",\n  \"age\": 3,\n  \"weight\": 28.5,\n  \"location\": {\n    \"lat\": 12.9716,\n    \"lng\": 77.5946\n  },\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/animals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "animals"]
