    {
      "name": "04 Sensors & Telemetry",
      "description": "High-speed sensor telemetry ingestion (ESP32 / Collar), latest vitals polling, and historical timeseries queries.",
      "item": [
        {
          "name": "POST /api/sensor (Ingest Telemetry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"animalId\": \"{{animalId}}\",\n  \"physiology\": {\n    \"temperature\": 38.6,\n    \"heartRate\": 82,\n    \"respiratoryRate\": 21,\n    \"bloodOxygen\": 98\n  },\n  \"behavior\": {\n    \"motion\": true,\n    \"steps\": 4,\n    \"lyingDown\": false\n  },\n  \"device\": {\n    \"signalStrength\": -68\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sensor"]
            },
            "description": "Ingests a live telemetry reading matching the ESP32 collar hardware data schema."
          },
          "response": []
        },
        {
          "name": "GET /api/sensor/latest/:animalId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sensor/latest/{{animalId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sensor", "latest", "{{animalId}}"]
            },
            "description": "Gets the most recent telemetry packet for an animal."
          },
          "response": []
        },
        {
          "name": "GET /api/sensor/history/:animalId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sensor/history/{{animalId}}?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sensor", "history", "{{animalId}}"],
              "query": [
                {
                  "key": "from",
                  "value": "{{from}}",
                  "description": "Start ISO datetime"
                },
                {
                  "key": "to",
                  "value": "{{to}}",
                  "description": "End ISO datetime"
                }
              ]
            },
            "description": "Gets historical telemetry readings for charts."
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 Alerts & Notifications",
      "description": "Critical vital anomalies, rule violations, triage status management, and veterinary notifications.",
      "item": [
        {
          "name": "GET /api/alerts/active",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const alerts = body.data || body;",
                  "  if (Array.isArray(alerts) && alerts.length > 0) {",
                  "    pm.environment.set('alertId', alerts[0]._id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alerts", "active"]
            },
            "description": "Retrieves all currently active, unresolved clinical alerts."
          },
          "response": []
        },
        {
          "name": "GET /api/alerts/animal/:animalId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/animal/{{animalId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alerts", "animal", "{{animalId}}"]
            },
            "description": "Retrieves the alert history for a specific animal."
          },
          "response": []
        },
        {
          "name": "PATCH /api/alerts/:alertId/status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"acknowledged\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/alerts/{{alertId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alerts", "{{alertId}}", "status"]
            },
            "description": "Updates status of an alert ('active', 'acknowledged', or 'resolved')."
          },
          "response": []
        }
      ]
