{
  "info": {
    "_postman_id": "6bce0a25-c1b7-4f26-9141-mavis-full-api",
    "name": "MAVIS API - Complete Test Suite",
    "description": "Comprehensive, categorized Postman collection for MAVIS (Multi-Model Animal Vitality Intelligence System). Covers Health, Authentication, Animal Registry, Telemetry Ingestion, Clinical Alerts, AI Diagnosis, and Validation Edge Cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health & Status",
      "description": "System health and database liveness verification endpoints.",
      "item": [
        {
          "name": "GET / (Health Check)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Checks whether the MAVIS backend server is running and reports database connection state."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Authentication & Profile",
      "description": "User registration, login, profile management, and notification settings.",
      "item": [
        {
          "name": "POST /api/auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.user) {",
                  "    pm.environment.set('userId', json.data.user.id || json.data.user._id);",
                  "  }",
                  "  if (json.data && json.data.token) {",
                  "    pm.environment.set('token', json.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Jane Doe\",\n  \"email\": \"vet.jane@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user account on MAVIS and returns a session token."
          },
          "response": []
        },
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
